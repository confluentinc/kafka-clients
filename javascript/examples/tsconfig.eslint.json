// The program ESLint's typed rules read for the examples
// (scripts/lint/eslint/config.js): examples/tsconfig.json with the package's
// import paths mapped to its sources, src/, so the linter needs no build of
// dist/. The type check of the examples (`make typecheck-examples`) reads
// the compiled declarations instead, as an app does.
{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": [
      "es2022",
      "es2024.string"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@confluentinc/kafka-javascript": [
        "../src/index.ts"
      ],
      "@confluentinc/kafka-javascript/*": [
        "../src/*/index.ts"
      ]
    }
  },
  "include": [
    "**/*.js"
  ]
}

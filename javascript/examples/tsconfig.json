// The type check of the examples (`make typecheck-examples`,
// scripts/typecheck_tests.js examples): `tsc --strict` over every example,
// through `checkJs`, as `node` runs them. The package's own import paths
// (`@confluentinc/kafka-javascript/...`) resolve, through package.json's
// exports, to the compiled declarations in dist/, so it runs after `make
// build-ts`, as an app's code types against them. The settings are the
// tests' (test/tsconfig.json) with Node's globals only; `include` names every
// extension, as the script checks.
{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2022", "es2024.string"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "types": ["node"],
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.js", "**/*.mjs", "**/*.cjs", "**/*.ts", "**/*.mts", "**/*.cts"]
}

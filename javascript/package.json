{
  "name": "@confluentinc/kafka-javascript",
  "version": "4.4.0-beta.1",
  "private": true,
  "description": "Node.js client for Apache Kafka over the Confluent Kafka Rust client's C FFI (preview: producer only)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/confluentinc/kafka-clients.git",
    "directory": "javascript"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "default": "./dist/common/index.js"
    },
    "./common/config": {
      "types": "./dist/common/config/index.d.ts",
      "default": "./dist/common/config/index.js"
    },
    "./common/errors": {
      "types": "./dist/common/errors/index.d.ts",
      "default": "./dist/common/errors/index.js"
    },
    "./common/metrics": {
      "types": "./dist/common/metrics/index.d.ts",
      "default": "./dist/common/metrics/index.js"
    },
    "./common/network": {
      "types": "./dist/common/network/index.d.ts",
      "default": "./dist/common/network/index.js"
    },
    "./common/protocol": {
      "types": "./dist/common/protocol/index.d.ts",
      "default": "./dist/common/protocol/index.js"
    },
    "./common/protocol/types": {
      "types": "./dist/common/protocol/types/index.d.ts",
      "default": "./dist/common/protocol/types/index.js"
    },
    "./common/requests": {
      "types": "./dist/common/requests/index.d.ts",
      "default": "./dist/common/requests/index.js"
    },
    "./common/security": {
      "types": "./dist/common/security/index.d.ts",
      "default": "./dist/common/security/index.js"
    },
    "./common/security/auth": {
      "types": "./dist/common/security/auth/index.d.ts",
      "default": "./dist/common/security/auth/index.js"
    },
    "./consumer": {
      "types": "./dist/consumer/index.d.ts",
      "default": "./dist/consumer/index.js"
    },
    "./producer": {
      "types": "./dist/producer/index.d.ts",
      "default": "./dist/producer/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "common": [
        "dist/common/index.d.ts"
      ],
      "common/config": [
        "dist/common/config/index.d.ts"
      ],
      "common/errors": [
        "dist/common/errors/index.d.ts"
      ],
      "common/metrics": [
        "dist/common/metrics/index.d.ts"
      ],
      "common/network": [
        "dist/common/network/index.d.ts"
      ],
      "common/protocol": [
        "dist/common/protocol/index.d.ts"
      ],
      "common/protocol/types": [
        "dist/common/protocol/types/index.d.ts"
      ],
      "common/requests": [
        "dist/common/requests/index.d.ts"
      ],
      "common/security": [
        "dist/common/security/index.d.ts"
      ],
      "common/security/auth": [
        "dist/common/security/auth/index.d.ts"
      ],
      "consumer": [
        "dist/consumer/index.d.ts"
      ],
      "producer": [
        "dist/producer/index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "gypfile": false,
  "scripts": {
    "build": "make build",
    "test": "make test",
    "test:static": "make test-static",
    "test:unit": "make test-unit",
    "test:typing": "make test-typing",
    "test:integration": "make test-integration"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@types/node": "20.19.41",
    "typescript": "5.9.3"
  }
}

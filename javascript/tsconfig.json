// The library build (`make -C javascript build`): lib/**/*.ts -> dist/, as
// CommonJS (the package has no "type", so `module: node16` emits CommonJS,
// which `require` loads and an ES module `import`s through Node's CommonJS
// interop), with declarations and source maps. ES2022 is what Node 18 runs.
{
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "lib": ["es2022"],
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "rootDir": "lib",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "newLine": "lf",
    "noEmitOnError": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["lib/**/*.ts"]
}

// The type check of the tests (`make typecheck-tests`, scripts/typecheck_tests.js;
// root conventions, Tests, Q67, and Build, packaging and release, Q74): `tsc
// --strict` over every file under test/, the JavaScript tests through
// `checkJs`, as Jest runs them (jest.config.cjs). No file is excluded: the
// rule linter's fixtures are strings inside the tests, not files of their own.
// The package's own import paths (`@confluentinc/kafka-javascript/...`)
// resolve, through package.json's exports, to the compiled declarations in
// dist/, so it runs after `make build-ts`, as a user's code would type against
// them. The compiler settings are the library's (tsconfig.json), with the
// Jest globals beside Node's; `skipLibCheck` leaves the declarations of the
// dependencies unchecked (tinypool's, which jest_runner.mjs imports, name the
// DOM's Worker), and dist/'s are checked by the build that writes them.
{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2022", "es2024.string"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node", "jest"],
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.js", "**/*.mjs", "**/*.ts"]
}

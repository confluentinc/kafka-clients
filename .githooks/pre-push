#!/usr/bin/env bash
# Pre-push hook: makes sure a pushed HEAD carries a test selection made for it
# (`make pre-push-test-selection`, with AGENT, AGENT_MODEL and BASE as for
# `make select-tests`). Installed by `make init-hooks`, which `make init` runs
# and which sets core.hooksPath to .githooks. Bypass with `git push --no-verify`.
#
# When HEAD is pushed and its committed test-selection/ folder holds no
# selection made for it, the agent selects the tests the changes from BASE can
# affect, the folder is committed (keeping its four most recent selections),
# and that commit is pushed to the remote refs this push sends HEAD to, with
# GIT_PUSH_COMMAND (run by sh, followed by the remote and the refspecs) or else
# `git push`. This push then fails: git has already chosen the commits it
# pushes. With uncommitted changes, or when the selection fails, the push goes
# on without one, and CI runs every test.
#
# The hook's output is also appended to .git/pre-push.log, since a push command
# such as git_push_external may show it only when the push fails, and a failed
# selection lets the push go on with a warning alone. It is appended, not
# rewritten, because the push the hook makes runs the hook again.
set -e
cd "$(git rev-parse --show-toplevel)"
log="$(git rev-parse --absolute-git-dir)/pre-push.log"
echo "== $(date '+%Y-%m-%d %H:%M:%S') pre-push to $1" >> "$log"
make -s pre-push-test-selection PUSH_REMOTE="$1" 2>&1 | tee -a "$log" >&2
exit "${PIPESTATUS[0]}"

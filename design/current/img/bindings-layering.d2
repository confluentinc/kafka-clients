# How the C and Python bindings sit on the async Rust API.
#
# Source of truth for design/current/img/bindings-layering.svg.
# Render with: make -C design/current d2
#
# The point of this diagram: the C API mirrors the Rust (and so the Java)
# surface one-to-one under CLAUDE.md §4 -- a blocking entry point per Rust
# `async fn` plus a `_cb` twin whose completion is queued on the client's
# callbacks vector and run by `_execute_callbacks` on a caller thread; a
# sync Rust `fn` crosses once. No Rust thread ever runs a user callback.
# Both bindings are thin layers over that surface.

direction: down

py: "python/ — producer.py, consumer.py, admin.py\nProducer / Consumer / AdminClient (sync: _cb entry points, sliced wait in Python via SyncWaiter)\nAsync* twins (asyncio: _cb entry points + set_callbacks_notify -> call_soon_threadsafe(execute_callbacks))" {
  style.fill: "#eef6ff"
}
pyext: "_confluentkafka.c — hand-written CPython extension"
c: "C callers / c/tests (Unity) / c/grpc_server"

header: "rust/target/include/confluent_kafka.h\n(cbindgen, feature ffi; checked by cargo xtask lint-custom check-ffi-translation)" {
  style.fill: "#f3f0ff"
}

ffi: "rust/src/ffi/ — one file per Java class under common/, producer/, consumer/, admin/\n+ util.rs (kafka_List_t, kafka_Map_t, kafka_Bytes_t), kafka_future.rs, callback_queue.rs" {
  style.fill: "#fff7e6"

  sync: "blocking entry point (one per Rust method)\nruntime.block_on(api(...)) for an async fn\nfallible: returns *mut kafka_common_Error_t (NULL = ok),\nvalue through trailing out_<name>"
  cb: "_cb twin (only for an async Rust fn)\nspawn on the client's runtime;\ncompletion -> CallbackQueue -> <Client>_execute_callbacks()\n-> <fn>_cb_t(value, error, opaque) on the pumping thread"
  iface: "interfaces (traits C implements)\n<Interface>_new(void *self, <method>_fn_t ...)\nasync method -> callback_id + <Client>__set_callback_result\nclass handles bridge with <Class>__as_<Interface>()"
}

core: "Rust public API — Producer / Consumer / Admin\n(async fn, sync fn, KafkaFuture<T> -> kafka_common_KafkaFuture_t)" {
  style.fill: "#e8f5e9"
}

py -> pyext -> header
c -> header
header -> ffi.sync
header -> ffi.cb
header -> ffi.iface
ffi.sync -> core
ffi.cb -> core
core -> ffi.iface: "calls back"

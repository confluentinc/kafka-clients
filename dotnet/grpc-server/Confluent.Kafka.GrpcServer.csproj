<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The .NET gRPC backend for the Rust multilanguage integration-test harness
    (consumer M8/P1+P2; producer M12/P1). NOT part of the shipped Confluent.Kafka
    package — it is a test-harness artifact that exposes the binding's generic
    KafkaProducer/MockProducer and KafkaConsumer/MockConsumer (both
    <byte[],byte[]> with Serdes.ByteArray) over the ProducerService +
    ConsumerService gRPC contracts, so the repo's producer AND consumer
    integration tests can run against the .NET binding (the .NET twin of the
    Python / C backends). One server per flavor hosts BOTH services
    (Python-parity), flavor-selected by CONSUMER_FLAVOR (Program.cs). See
    design/history/M8/P1-sync-consumer-grpc-backend/PLAN.md and
    design/history/M12/P1-producer-grpc-backend/PLAN.md.

    Framework choice (PLAN item B): Grpc.AspNetCore (Kestrel) — the supported,
    pure-managed HTTP/2 server path (Grpc.Core is EOL). Serves h2c (cleartext
    HTTP/2, no TLS) because the Rust client dials http:// (Program.cs).

    Target frameworks (M17/P1 D3): net8.0 AND net10.0. The Docker images publish
    the net8.0 leg (-f net8.0) onto the aspnet:8.0 runtime, unchanged. The native
    (host-process) build uses the net10.0 leg (dotnet/'s `make grpc-native`,
    -f net10.0), because the SDK 10 installs locally and in CI bring the
    ASP.NET Core 10 runtime but no ASP.NET Core 8 one, which a net8.0 build of a
    Microsoft.NET.Sdk.Web app needs to run. That native leg also gives the
    library's net10.0 asset broker-level coverage.

    Directory.Build.props (at dotnet/) auto-applies: #nullable enable,
    the dotnet/runtime code style, TreatWarningsAsErrors, and strong-name
    signing. The generated protobuf/gRPC stubs are auto-generated code and are
    skipped by the code-style/CA analyzers; NoWarn below relaxes the two
    compiler/CA rules that clash with the faithful Python-parity port (a broad
    catch that mirrors grpc_server.py; generated-code warnings).
  -->

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Confluent.Kafka.GrpcServer</RootNamespace>
    <AssemblyName>Confluent.Kafka.GrpcServer</AssemblyName>
    <Nullable>enable</Nullable>
    <!-- Test-harness executable — never packed, no XML doc file (so no CS1591). -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      CA1031: the servicer catches System.Exception broadly on purpose — it is
      a faithful port of grpc_server.py's `except Exception` that funnels every
      failure into a proto KafkaError (Translate.ToProto). This is the harness
      contract, not a defect, so the rule is relaxed for this project only.
    -->
    <NoWarn>$(NoWarn);CA1031</NoWarn>
  </PropertyGroup>

  <!--
    Proto codegen (PLAN item A; M12/P1 producer). Single source of truth = the
    proto crate at rust/multilanguage-test-server/proto (the repo root is 2 dir
    levels up: grpc-server -> dotnet -> repo). ProtoRoot puts the proto dir on protoc's
    import path so `import "producer_service.proto"` resolves. Both services are
    compiled with GrpcServices="Server": consumer_service.proto (M8) and now
    producer_service.proto (M12/P1) — the .NET backend hosts BOTH ProducerService
    and ConsumerService from one server (Python-parity, PLAN §3). The shared
    messages (KafkaError / PartitionInfo / Node / Header / StatusResponse /
    PartitionsForResponse) are defined once in producer_service.proto and reused
    by the consumer service. Flipping producer_service.proto from
    GrpcServices="None" to "Server" is a binding-local BUILD-CONFIG change — it
    emits the ProducerService server base into the same assembly; the proto
    CONTENT is untouched. Grpc.Tools flows in transitively via Grpc.AspNetCore.
  -->
  <PropertyGroup>
    <ProtoRoot>$(MSBuildProjectDirectory)/../../rust/multilanguage-test-server/proto</ProtoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="$(ProtoRoot)/producer_service.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="Server" />
    <Protobuf Include="$(ProtoRoot)/consumer_service.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="Server" />
    <!--
      M15/P12 CP2: admin_service.proto joins the two above, same build-config-only
      flip (proto CONTENT untouched). It imports both of them for the shared
      KafkaError / Node / StatusResponse / TopicPartition / StringList messages.
    -->
    <Protobuf Include="$(ProtoRoot)/admin_service.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="Server" />
    <!--
      M18/P1 S1: chaos_service.proto (upstream #184's chaos-harness contract)
      joins the others, same build-config-only line (proto CONTENT untouched).
      It imports producer_service.proto for the shared messages, and emits the
      ChaosWorkloadService server base.
    -->
    <Protobuf Include="$(ProtoRoot)/chaos_service.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Confluent.Kafka/Confluent.Kafka.csproj" />
  </ItemGroup>

  <!--
    M18/P1 S2: the gRPC-server unit tests (dotnet/tests/Confluent.Kafka.GrpcServer.UnitTests,
    a local gate outside the solution) drive the internal chaos servicer through its internal
    client-factory constructor (PLAN §5.1 D10). Every assembly here is strong-named
    (Directory.Build.props), so the grant carries the shared public key, as in the soak and
    library projects.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Confluent.Kafka.GrpcServer.UnitTests" Key="" />
  </ItemGroup>

</Project>

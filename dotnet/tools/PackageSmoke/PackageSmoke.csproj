<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The smoke test of the Confluent.Kafka package (.semaphore/test-nupkg.sh): a user's program that
    references the package, built and run on each platform and Linux distribution the package
    supports. Outside the solution: it builds only against a package, never against the project.

    Build with -p:ConfluentKafkaVersion=<version>, from a nuget.config that maps Confluent.Kafka to
    the feed holding that version only.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- .NET Framework, which runs only on Windows, runs the package's net462 assembly. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net462;net8.0;net10.0</TargetFrameworks>
    <!-- The C# of the program, which .NET Framework's default language version predates. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    net8.0 is a .NET 8 application's build: the package has no net8.0 assembly, so NuGet gives it the
    netstandard2.0 one and the dependencies the nuspec lists for it, as it gives a .NET 8 or 9 user. It
    runs on .NET 10 (RollForward), the only runtime CI installs: .NET 8 is out of Microsoft support, so
    nothing here runs on it. CheckEolTargetFramework: an SDK that lists net8.0 as out of support warns
    (NETSDK1138), which TreatWarningsAsErrors would make an error, although the leg only builds against
    .NET 8's reference assemblies.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <RollForward>Major</RollForward>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="[$(ConfluentKafkaVersion)]" />
  </ItemGroup>

  <Target Name="RequireConfluentKafkaVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(ConfluentKafkaVersion)' == ''" Text="Build with -p:ConfluentKafkaVersion=&lt;the version of the Confluent.Kafka package to test&gt;." />
  </Target>

</Project>

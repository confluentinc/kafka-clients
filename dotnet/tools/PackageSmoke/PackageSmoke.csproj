<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The smoke test of the Confluent.Kafka package (.semaphore/test-nupkg.sh): a user's program that
    references the package, built and run on each platform and Linux distribution the package
    supports. Outside the solution: it builds only against a package, never against the project.

    Build with -p:ConfluentKafkaVersion=<version>, from a nuget.config that maps Confluent.Kafka to
    the feed holding that version only.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="[$(ConfluentKafkaVersion)]" />
  </ItemGroup>

  <Target Name="RequireConfluentKafkaVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(ConfluentKafkaVersion)' == ''" Text="Build with -p:ConfluentKafkaVersion=&lt;the version of the Confluent.Kafka package to test&gt;." />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The verifiable clients' shared code and the two tools: ports of Kafka's
    org.apache.kafka.tools.VerifiableProducer and VerifiableConsumer (and
    org.apache.kafka.server.util.ThroughputThrottler), over the binding's public sync API, for
    Kafka's ducktape system tests. The Exes beside this project only call into it.
  -->

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Confluent.Kafka.Tools</RootNamespace>
    <AssemblyName>VerifiableClients</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Confluent.Kafka/Confluent.Kafka.csproj" />
  </ItemGroup>

  <!-- The types are internal; the Exes and the tests are strong-named with the one shared key. -->
  <ItemGroup>
    <InternalsVisibleTo Include="VerifiableProducer" Key="" />
    <InternalsVisibleTo Include="VerifiableConsumer" Key="" />
    <InternalsVisibleTo Include="VerifiableClients.Tests" Key="" />
  </ItemGroup>

</Project>

# The Native AOT twin of Dockerfile.grpc: the same .NET gRPC backend image, with
# the server and binding compiled to one native executable (GrpcServerAot,
# Confluent.Kafka.GrpcServer.csproj) that runs in an image with no .NET runtime.
# The container arm runs against it to check that the AOT-compiled server passes
# the suite the JIT-compiled one does.
#
# Build context MUST be the repo root, as for Dockerfile.grpc. Use the Makefile
# target:
#   make -C dotnet grpc-image-aot
#
# Tags the result as confluent-kafka-rust/dotnet-grpc-server:$MULTILANG_IMAGE_TAG-aot,
# `dev-aot` by default. Requires the LINUX libconfluent_kafka.so under
# rust/target/debug/ first, as Dockerfile.grpc does.

# ---------------------------------------------------------------------------
# Stage 1: Restore + publish the grpc-server app as a Native AOT executable
# against the prebuilt Rust shared lib. Proto codegen (Grpc.Tools) runs here.
# ---------------------------------------------------------------------------
# The SDK image with the Native AOT prerequisites: clang and the zlib
# development files, which the net8.0 link needs.
FROM mcr.microsoft.com/dotnet/sdk:10.0-noble-aot AS builder

WORKDIR /src

# The cargo profile directory of the host-built library (dotnet/Makefile passes it).
ARG RUST_PROFILE=debug

# The repo layout the csprojs expect, as in Dockerfile.grpc.
COPY rust/target/${RUST_PROFILE}/libconfluent_kafka.so /src/rust/target/${RUST_PROFILE}/libconfluent_kafka.so
COPY rust/target/include/confluent_kafka.h /src/rust/target/include/confluent_kafka.h
COPY dotnet/Directory.Build.props /src/dotnet/Directory.Build.props
COPY dotnet/.editorconfig /src/dotnet/.editorconfig
COPY dotnet/Confluent.Kafka.snk /src/dotnet/Confluent.Kafka.snk
COPY dotnet/analyzers/Confluent.Kafka.Analyzers /src/dotnet/analyzers/Confluent.Kafka.Analyzers
COPY dotnet/analyzers/*.txt /src/dotnet/analyzers/
COPY dotnet/src /src/dotnet/src
COPY dotnet/grpc-server /src/dotnet/grpc-server
COPY rust/multilanguage-test-server/proto /src/rust/multilanguage-test-server/proto

# Scrub any bin/obj that rode in from a dev-machine build context, as in
# Dockerfile.grpc.
RUN find /src/dotnet -type d \( -name bin -o -name obj \) -prune -exec rm -rf {} +

# Publish the server's net8.0 leg, as Dockerfile.grpc does, as Native AOT for this
# image's platform. A trim or AOT warning fails the publish (TreatWarningsAsErrors).
RUN dotnet publish /src/dotnet/grpc-server/Confluent.Kafka.GrpcServer.csproj \
        -c Release -p:CargoProfileDir=${RUST_PROFILE} -p:GrpcServerAot=true -f net8.0 \
        --use-current-runtime -o /app

# ---------------------------------------------------------------------------
# Stage 2: runtime-deps, the operating-system libraries a .NET app needs and no
# .NET runtime: the server is native code. The Ubuntu 24.04 (Noble) tag, for the
# glibc reason given in Dockerfile.grpc.
# ---------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/runtime-deps:8.0-noble AS runtime

WORKDIR /app

ARG RUST_PROFILE=debug

COPY --from=builder /app /app
COPY --from=builder /src/rust/target/${RUST_PROFILE}/libconfluent_kafka.so /app/libconfluent_kafka.so

ENV LD_LIBRARY_PATH=/app

ENV CONSUMER_FLAVOR=sync

ENV GRPC_HOST=0.0.0.0

EXPOSE 50053

# The Rust BackendPool waits for the substring "listening" on stderr, as for
# Dockerfile.grpc.
CMD ["/app/Confluent.Kafka.GrpcServer"]

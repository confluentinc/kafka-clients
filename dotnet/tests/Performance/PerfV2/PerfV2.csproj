<Project Sdk="Microsoft.NET.Sdk">

  <!--
    v2 perf executable: the head-to-head baseline over confluent-kafka-dotnet (librdkafka). It references
    the shared, client-free PerformanceCommon engine and the Confluent.Kafka NuGet package, and adapts
    its Produce/ProduceAsync and Consume to the same backend interfaces PerfV3 implements, so both exes
    feed the same measured-loop engine. MODE={producer,consumer,version} selects what runs: the client
    is the exe boundary, so producer and consumer share one exe.

    Same-assembly collision: this binding and confluent-kafka-dotnet are both the `Confluent.Kafka`
    assembly and namespace, and two DLLs with the same simple name cannot coexist in one project. This
    exe references only the NuGet package; PerfV3 references only this repo's binding. The two exes must
    never share a project or solution. PerformanceCommon is client-free, so both can reference it.

    Unlike PerfV3, this exe needs no native cdylib and no Rust build: the package carries its own
    librdkafka native as runtimes/{rid}/native assets.

    The package ships net10.0 and net8.0 assets, so this exe keeps the suite's net8.0;net10.0 matrix.

    Directory.Build.props (at dotnet/) auto-applies (#nullable enable, dotnet/runtime code style,
    TreatWarningsAsErrors, strong-name signing). Kept out of Confluent.Kafka.sln, and never in any
    solution alongside PerfV3.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Confluent.Kafka.Performance.V2</RootNamespace>
    <AssemblyName>PerfV2</AssemblyName>
    <!-- Perf executable — never packed, no XML doc file (so no CS1591). -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      The runtime every client is measured on, pinned rather than left to the SDK defaults: Workstation
      GC with background (concurrent) collection, and tiered PGO on. MODE=version reports what the
      process actually runs with.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!--
      Scoped NoWarn for this exe only (the interop with confluent-kafka-dotnet may need a slightly wider
      set than PerfV3, since that package's public API is outside our style and analyzer control):
        CA1031 — the mode entry points catch System.Exception broadly on purpose (a faithful port of the
                 Python perf tests' try/except Exception around close/verify, which logs and continues);
                 same relaxation as PerfV3 / PerformanceCommon.
        CA1849 — the sync producer backend's send handle intentionally blocks on a delivery
                 TaskCompletionSource, on the engine's recorder thread (the ckd sync path has no blocking
                 produce; CompatibleProducer's future is waited synchronously, as Python's fut.result()).
                 The analyzer would prefer an async call, but the sync backend is sync by contract.
    -->
    <NoWarn>$(NoWarn);CA1031;CA1849</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PerformanceCommon/PerformanceCommon.csproj" />
    <!-- confluent-kafka-dotnet (the v2 baseline), pinned to the latest stable 2.x and to the version
         python/test/performance/requirements-librdkafka.txt pins, so both librdkafka arms run one
         librdkafka. Confined to PerfV2: never added to the shipped src/Confluent.Kafka binding. -->
    <PackageReference Include="Confluent.Kafka" Version="2.16.0" />
  </ItemGroup>

</Project>

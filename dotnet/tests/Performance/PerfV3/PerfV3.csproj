<Project Sdk="Microsoft.NET.Sdk">

  <!--
    v3 perf executable: the head-to-head benchmark over this repo's binding (Confluent.Kafka). It
    references the shared, client-free PerformanceCommon engine and the binding, and adapts
    KafkaProducer/AsyncKafkaProducer and KafkaConsumer/AsyncKafkaConsumer (both <byte[],byte[]> with
    Serdes.ByteArray()) to the backend interfaces. MODE={producer,consumer,version} selects what runs:
    the client is the exe boundary, so producer and consumer share one exe.

    Same-assembly collision: this exe references this repo's Confluent.Kafka; PerfV2 references
    confluent-kafka-dotnet's Confluent.Kafka. The two must never share a project or solution: separate
    exes with separate output dirs keep the two Confluent.Kafka assemblies from colliding.

    Two-stage build: `cargo build` must produce the native cdylib first; the ProjectReference to
    Confluent.Kafka carries the native (its Content copy) transitively into this exe's output, where
    default [DllImport] probing resolves it.

    Directory.Build.props (at dotnet/) auto-applies (#nullable enable, dotnet/runtime code style,
    TreatWarningsAsErrors, strong-name signing). Kept out of Confluent.Kafka.sln.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Confluent.Kafka.Performance.V3</RootNamespace>
    <AssemblyName>PerfV3</AssemblyName>
    <!-- Perf executable — never packed, no XML doc file (so no CS1591). -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      The runtime every client is measured on, pinned rather than left to the SDK defaults: Workstation
      GC with background (concurrent) collection, and tiered PGO on. MODE=version reports what the
      process actually runs with.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!--
      CA1031: the mode entry points catch System.Exception broadly on purpose — a faithful port of the
      Python perf tests' `try/except Exception` around baseline capture / verification, which logs and
      continues rather than aborting the whole run. Scoped to this project only (grpc-server precedent).
    -->
    <NoWarn>$(NoWarn);CA1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PerformanceCommon/PerformanceCommon.csproj" />
    <ProjectReference Include="../../../src/Confluent.Kafka/Confluent.Kafka.csproj" />
  </ItemGroup>

</Project>

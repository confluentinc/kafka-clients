# macOS-only variant of Dockerfile.grpc: builds libconfluent_kafka.a inside
# the image (the host build is Mach-O, unusable in a Linux container) rather
# than COPYing a host artifact. No `--platform` on FROM -- see the Makefile
# recipe. Build context MUST be the repo root: make -C bindings/c grpc-image-macos

# Stage 1: Build libconfluent_kafka.a from source.
FROM debian:trixie-slim AS rust-builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl build-essential cmake pkg-config perl && \
    rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH

WORKDIR /workspace

COPY rust-toolchain.toml ./rust-toolchain.toml
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --default-toolchain none && \
    rustup show

COPY . /workspace
RUN cargo build --release --features ffi

# Stage 2: Compile kafka_grpc_server. (Identical to Dockerfile.grpc.)
FROM debian:trixie-slim AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential cmake pkg-config \
        libgrpc++-dev libprotobuf-dev \
        protobuf-compiler protobuf-compiler-grpc \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY bindings/c/grpc_server/CMakeLists.txt /build/CMakeLists.txt
COPY bindings/c/grpc_server/server.cc /build/server.cc
COPY --from=rust-builder /workspace/target/release/libconfluent_kafka.a /build/lib/libconfluent_kafka.a
COPY --from=rust-builder /workspace/target/include/confluent_kafka.h /build/include/confluent_kafka.h
COPY multilanguage-test-server/proto/producer_service.proto /build/proto/producer_service.proto
COPY multilanguage-test-server/proto/consumer_service.proto /build/proto/consumer_service.proto

RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build --parallel

# Stage 3: Minimal runtime. (Identical to Dockerfile.grpc.)
FROM debian:trixie-slim AS runtime

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libgrpc++-dev libprotobuf-dev ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/build/kafka_grpc_server /usr/local/bin/kafka_grpc_server

EXPOSE 50052

CMD ["/usr/local/bin/kafka_grpc_server"]

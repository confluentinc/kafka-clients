<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <AssemblyName>Confluent.Kafka.ShareConsumer</AssemblyName>
    <RootNamespace>Confluent.Kafka.ShareConsumer</RootNamespace>
    <!--
      Forward-setup for the P/Invoke boundary (src/Internal/Interop). No unsafe
      code exists yet this milestone; the flag is on so the boundary compiles when
      the hand-marshalling helpers land (ffi-marshalling.md §A3/§A4/§B3/§B4).
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Compile src/** ONLY. The tests/ tree is nested under this project directory but
    is a SEPARATE project; it must not be globbed into the library assembly.
  -->
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <!-- Grant the unit-test assembly access to internals (Native, SafeHandles, …). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Confluent.Kafka.ShareConsumer.UnitTests" />
  </ItemGroup>

</Project>

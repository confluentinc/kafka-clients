<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The .NET gRPC consumer backend for the Rust multilanguage integration-test
    harness (M8/P1). NOT part of the shipped Confluent.Kafka package — it is a
    test-harness artifact that exposes the binding's synchronous
    KafkaConsumer<byte[],byte[]> / MockConsumer<byte[],byte[]> over the
    ConsumerService gRPC contract so the repo's consumer integration tests can
    run against the .NET binding (the consumer-side twin of the Python / C
    backends). See design/history/M8/P1-sync-consumer-grpc-backend/PLAN.md.

    Framework choice (PLAN item B): Grpc.AspNetCore (Kestrel) on net8.0 — the
    supported, pure-managed HTTP/2 server path (Grpc.Core is EOL). Serves h2c
    (cleartext HTTP/2, no TLS) because the Rust client dials http:// (Program.cs).

    Directory.Build.props (at bindings/dotnet/) auto-applies: #nullable enable,
    the dotnet/runtime code style, TreatWarningsAsErrors, and strong-name
    signing. The generated protobuf/gRPC stubs are auto-generated code and are
    skipped by the code-style/CA analyzers; NoWarn below relaxes the two
    compiler/CA rules that clash with the faithful Python-parity port (a broad
    catch that mirrors grpc_server.py; generated-code warnings).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Confluent.Kafka.GrpcServer</RootNamespace>
    <AssemblyName>Confluent.Kafka.GrpcServer</AssemblyName>
    <Nullable>enable</Nullable>
    <!-- Test-harness executable — never packed, no XML doc file (so no CS1591). -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      CA1031: the servicer catches System.Exception broadly on purpose — it is
      a faithful port of grpc_server.py's `except Exception` that funnels every
      failure into a proto KafkaError (Translate.ToProto). This is the harness
      contract, not a defect, so the rule is relaxed for this project only.
    -->
    <NoWarn>$(NoWarn);CA1031</NoWarn>
  </PropertyGroup>

  <!--
    Proto codegen (PLAN item A). Single source of truth = the proto crate at
    multilanguage-test-server/proto (3 dir levels up: grpc-server -> dotnet ->
    bindings -> repo). ProtoRoot puts the proto dir on protoc's import path so
    `import "producer_service.proto"` resolves. producer_service.proto is
    compiled messages-only (GrpcServices=None) — we reuse its shared messages
    (KafkaError / PartitionInfo / Node / Header / StatusResponse /
    PartitionsForResponse) but implement ConsumerService only.
    Grpc.Tools flows in transitively via Grpc.AspNetCore.
  -->
  <PropertyGroup>
    <ProtoRoot>$(MSBuildProjectDirectory)/../../../multilanguage-test-server/proto</ProtoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="$(ProtoRoot)/producer_service.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(ProtoRoot)/consumer_service.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Confluent.Kafka/Confluent.Kafka.csproj" />
  </ItemGroup>

</Project>

# create-ec2.sh's real AWS resource identifiers, kept out of this public repo.
#
# Copy this file to create-ec2.env in this same directory (it is sourced
# automatically by create-ec2.sh if present -- see .gitignore's `*.env` rule,
# which keeps create-ec2.env itself untracked while this .example file stays
# committed) OR export the same variables in your shell before running
# create-ec2.sh. Either way works; this file just saves retyping them.
#
# create-ec2.sh refuses to create (or --dry-run) an instance without these
# four: they identify a real AWS account's network and IAM structure, and
# must never be committed as defaults in a public repo. --terminate does not
# need them.

export SOAK_EC2_SUBNET_ID="subnet-xxxxxxxxxxxxxxxxx"
export SOAK_EC2_SECURITY_GROUP_ID="sg-xxxxxxxxxxxxxxxxx"
export SOAK_EC2_IAM_PROFILE="your-soak-tests-role"
export SOAK_EC2_AMI_ID="ami-xxxxxxxxxxxxxxxxx"

# Optional -- create-ec2.sh already has working defaults for these; uncomment
# only to change them for every invocation instead of passing a flag each time.
# export SOAK_EC2_LABEL="njc-rust-soak-tests"
# export SOAK_EC2_REGION="us-west-2"
# export SOAK_EC2_INSTANCE_TYPE="c6a.2xlarge"
# export SOAK_EC2_VOLUME_SIZE_GB="100"
# export SOAK_EC2_KEY_NAME="NJC-KEY"

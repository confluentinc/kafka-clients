# Multi-stage Docker build for the Python gRPC server image used by the
# multilanguage integration test harness. See
# design/history/MILESTONE-6/DESIGN-multilanguage-tests.md.
#
# Build context MUST be the repo root because we copy from target/ and
# multilanguage-test-server/. The Makefile target sets this for you:
#   make -C bindings/python grpc-image
#
# Tags the result as confluent-kafka-rust/python-grpc-server:dev.

# ---------------------------------------------------------------------------
# Stage 1: Build _confluentkafka.so against the prebuilt Rust shared lib
# and generate the gRPC proto stubs.
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc libc6-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Recreate the project layout that setup.py expects: setup.py lives at
# bindings/python/ and computes project_root = ../../, looking for the
# Rust header at target/include/confluent_kafka.h and the shared lib
# under target/release/.
COPY target/release/libconfluent_kafka.so /workspace/target/release/libconfluent_kafka.so
COPY target/include/confluent_kafka.h /workspace/target/include/confluent_kafka.h
COPY bindings/python/_confluentkafka.c /workspace/bindings/python/_confluentkafka.c
COPY bindings/python/setup.py /workspace/bindings/python/setup.py
COPY bindings/python/pyproject.toml /workspace/bindings/python/pyproject.toml
COPY bindings/python/producer.py /workspace/bindings/python/producer.py
COPY bindings/python/consumer.py /workspace/bindings/python/consumer.py

# Single source of truth for the wire schema: the proto crate.
COPY multilanguage-test-server/proto/producer_service.proto /workspace/proto/producer_service.proto
COPY multilanguage-test-server/proto/consumer_service.proto /workspace/proto/consumer_service.proto

# Build _confluentkafka.so. setup.py reads CONFLUENT_KAFKA_LIB_DIR for
# the Rust shared lib location.
ENV CONFLUENT_KAFKA_LIB_DIR=/workspace/target/release
RUN cd /workspace/bindings/python && \
    pip install --no-cache-dir setuptools wheel && \
    python setup.py build_ext --inplace

# Generate proto stubs for both services (consumer imports producer, so
# both are generated under the same -Iproto path).
RUN pip install --no-cache-dir grpcio==1.66.* grpcio-tools==1.66.* && \
    cd /workspace && \
    python -m grpc_tools.protoc \
        -Iproto \
        --python_out=/workspace/bindings/python \
        --grpc_python_out=/workspace/bindings/python \
        proto/producer_service.proto proto/consumer_service.proto

# ---------------------------------------------------------------------------
# Stage 2: Minimal runtime — Python + grpcio + the bundled artifacts.
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS runtime

# protobuf is needed by the generated stubs at runtime; grpcio doesn't
# pull it in transitively.
RUN pip install --no-cache-dir grpcio==1.66.* "protobuf>=4.0,<6.0"

WORKDIR /app

# Rust shared library next to the Python extension so the runtime
# loader resolves it via the rpath setup.py embedded.
COPY --from=builder /workspace/target/release/libconfluent_kafka.so /app/libconfluent_kafka.so
COPY --from=builder /workspace/bindings/python/_confluentkafka*.so /app/
COPY --from=builder /workspace/bindings/python/producer.py /app/producer.py
COPY --from=builder /workspace/bindings/python/consumer.py /app/consumer.py
COPY --from=builder /workspace/bindings/python/producer_service_pb2.py /app/producer_service_pb2.py
COPY --from=builder /workspace/bindings/python/producer_service_pb2_grpc.py /app/producer_service_pb2_grpc.py
COPY --from=builder /workspace/bindings/python/consumer_service_pb2.py /app/consumer_service_pb2.py
COPY --from=builder /workspace/bindings/python/consumer_service_pb2_grpc.py /app/consumer_service_pb2_grpc.py
# grpc_server.py imports the shared translation helpers from grpc_translate.py.
COPY bindings/python/grpc_translate.py /app/grpc_translate.py
# _error_code.py is generated from kafka_common_ErrorCode_t by
# `cargo xtask generate-error-codes`; grpc_translate.py and the servicers
# import it to stamp real codes on their own synthetic errors.
COPY bindings/python/_error_code.py /app/_error_code.py
COPY bindings/python/grpc_server.py /app/grpc_server.py

# The Python extension was linked with rpath pointing at the original
# CONFLUENT_KAFKA_LIB_DIR; setting LD_LIBRARY_PATH guarantees /app wins.
ENV LD_LIBRARY_PATH=/app

EXPOSE 50051

# The Rust BackendPool waits for "listening" on stderr — keep grpc_server.py
# in sync with the BackendPool's WaitFor::message_on_stderr setting.
CMD ["python", "/app/grpc_server.py"]

# Soak profile: 848-hi-throughput-rolling
#
# ~10 KB payloads (~800 KB/s) on the cluster whose brokers are rolled by the
# external K8s CronJob. Same message rate as every other profile: 80 msg/s.
# The soak client never rolls anything and never bounces its own consumer.
#
# Sourced by run.sh; every value may be overridden in the environment.

SOAK_VARIANT=848-hi-throughput-rolling

SOAK_RATE=80
SOAK_PAYLOAD_SIZE=10240

SOAK_PARTITIONS=2
SOAK_REPLICATION_FACTOR=-1

SOAK_ROLLING=true

# Lower stall threshold so consumer.recovery_ms captures each roll gap.
SOAK_EXTRA_ARGS="--stall-threshold 5"

SOAK_CLIENT_CONFIG="
consumer.group.protocol=consumer
consumer.enable.auto.commit=false
consumer.auto.offset.reset=earliest
consumer.fetch.max.bytes=52428800
consumer.max.partition.fetch.bytes=10485760
producer.linger.ms=5
producer.acks=all
producer.batch.size=1048576
producer.compression.type=lz4
"

# Soak profile: 848-hi-throughput-normal
#
# ~10 KB payloads on a cluster that is NOT rolled: ~800 KB/s. High throughput
# means ~200x the BYTES at the SAME message rate — 80 msg/s, exactly as in the
# other three profiles. (The Python soak's --perf flag only sets a ~10 KB pad
# and switches to batched pacing; the commit that added it left `-r 80`
# untouched.)
#
# Sourced by run.sh; every value may be overridden in the environment.

SOAK_VARIANT=848-hi-throughput-normal

SOAK_RATE=80
SOAK_PAYLOAD_SIZE=10240

SOAK_PARTITIONS=2
SOAK_REPLICATION_FACTOR=-1

SOAK_ROLLING=false

SOAK_EXTRA_ARGS=

# fetch.max.bytes / max.partition.fetch.bytes are raised so a poll can return a
# full batch of 10 KB records rather than a handful.
SOAK_CLIENT_CONFIG="
consumer.group.protocol=consumer
consumer.enable.auto.commit=false
consumer.auto.offset.reset=earliest
consumer.fetch.max.bytes=52428800
consumer.max.partition.fetch.bytes=10485760
producer.linger.ms=5
producer.acks=all
producer.batch.size=1048576
producer.compression.type=lz4
"

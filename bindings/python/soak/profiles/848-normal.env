# Soak profile: 848-normal
#
# Steady-state KIP-848 consumer group soak on a cluster that is NOT rolled.
# Sourced by run.sh; every value may be overridden in the environment.

SOAK_VARIANT=848-normal

# 80 msg/s is the rate for ALL FOUR profiles (confirmed against the Python
# soak's run.sh, which passes -r 80 for every variant). "High throughput"
# changes the payload size, not the message rate.
SOAK_RATE=80
SOAK_PAYLOAD_SIZE=50

SOAK_PARTITIONS=2
SOAK_REPLICATION_FACTOR=-1

# The cluster is not rolled under this profile; the client only reports what
# it observes either way.
SOAK_ROLLING=false

# Extra soakclient.py arguments, appended verbatim.
SOAK_EXTRA_ARGS=

# Client configuration appended to the -f config file. group.protocol=consumer
# is mandatory: the client defaults to `classic` and construction FAILS for it
# (KIP-848 only). enable.auto.commit=false because the soak commits
# synchronously itself, which is the only way to count commit failures.
SOAK_CLIENT_CONFIG="
consumer.group.protocol=consumer
consumer.enable.auto.commit=false
consumer.auto.offset.reset=earliest
producer.linger.ms=5
producer.acks=all
"

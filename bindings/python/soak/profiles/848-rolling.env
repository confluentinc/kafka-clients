# Soak profile: 848-rolling
#
# Same load as 848-normal, but pointed at the cluster whose brokers are rolled
# by the external K8s CronJob (cc-roll-kafka-cron). The soak client never rolls
# anything and never bounces its own consumer: it only observes and reports
# rebalances, coordinator moves, disconnects, assignment changes and recovery
# time, and proves zero loss across each roll.
#
# Sourced by run.sh; every value may be overridden in the environment.

SOAK_VARIANT=848-rolling

# Identical to 848-normal: the rolling variants differ only in which cluster
# they point at.
SOAK_RATE=80
SOAK_PAYLOAD_SIZE=50

SOAK_PARTITIONS=2
SOAK_REPLICATION_FACTOR=-1

SOAK_ROLLING=true

# A roll makes partitions unavailable for a few seconds at a time, so the stall
# threshold is lowered: consumer.recovery_ms should capture the roll gaps
# rather than smoothing over them.
SOAK_EXTRA_ARGS="--stall-threshold 5"

SOAK_CLIENT_CONFIG="
consumer.group.protocol=consumer
consumer.enable.auto.commit=false
consumer.auto.offset.reset=earliest
producer.linger.ms=5
producer.acks=all
"

#!/usr/bin/make -f

# One source package for the C core and the C++ binding (cpp/CLAUDE.md §13.4).
# The core is built by `cargo xtask install-c` into debian/core, then the C++
# library by its CMake project against it; both are installed into debian/tmp,
# which the packages take their files from. (debian/core, not debian/tmp: the
# binary targets' dh_prep clears debian/tmp.) The C++ packages carry the
# binding's own version.

include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/pkg-info.mk

CORE_LIBDIR := /usr/lib/$(DEB_HOST_MULTIARCH)
# The third word of `project(confluent_kafka_cpp VERSION x.y.z ...)`; the pattern
# has no parenthesis, which make would count against $(shell).
CPP_VERSION := $(shell awk '/^project.confluent_kafka_cpp VERSION / { print $$3 }' cpp/CMakeLists.txt)
DEB_REVISION := $(lastword $(subst -, ,$(DEB_VERSION)))

%:
	dh $@ --buildsystem=cmake+ninja --sourcedirectory=cpp --builddirectory=debian/build-cpp

CORE_STAGE := $(CURDIR)/debian/core
# The release profile carries no debug info; line tables give the core's
# -dbgsym package file and line numbers, which dh_strip moves out of the library.
export CARGO_PROFILE_RELEASE_DEBUG := line-tables-only

override_dh_auto_configure:
	cd rust && cargo xtask install-c --destdir $(CORE_STAGE) --prefix /usr --libdir $(CORE_LIBDIR)
	dh_auto_configure -- \
		-DCONFLUENT_KAFKA_INCLUDE_DIR=$(CORE_STAGE)/usr/include \
		-DCONFLUENT_KAFKA_LIB_DIR=$(CORE_STAGE)$(CORE_LIBDIR) \
		-DCONFLUENT_KAFKA_CPP_BUILD_TESTS=OFF

override_dh_auto_install:
	dh_auto_install
	cp -a $(CORE_STAGE)/usr debian/tmp/

# The unit tests run in the repository's own checks (make -C cpp verify).
override_dh_auto_test:

# Every program built against a version needs at least that version: the C
# exports change with the experimental FFI, so no symbols file is kept.
override_dh_makeshlibs:
	dh_makeshlibs -plibconfluent-kafka0 -V 'libconfluent-kafka0 (>= $(DEB_VERSION_UPSTREAM))'
	dh_makeshlibs -plibconfluent-kafka-cpp0.1 -V 'libconfluent-kafka-cpp0.1 (>= $(CPP_VERSION))'
	dh_makeshlibs --remaining-packages

override_dh_gencontrol:
	dh_gencontrol -plibconfluent-kafka-cpp0.1 -plibconfluent-kafka-cpp-dev -- \
		-v$(CPP_VERSION)-$(DEB_REVISION) -Vcore:Version=$(DEB_VERSION)
	dh_gencontrol --remaining-packages
